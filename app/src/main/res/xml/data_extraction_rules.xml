<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="azure-ai.db" />
        <exclude domain="database" path="azure-ai.db-wal" />
        <exclude domain="database" path="azure-ai.db-shm" />
        <exclude domain="database" path="azure-ai.db-journal" />
        <exclude domain="sharedpref" path="azure-ai-settings.xml" />
        <exclude domain="sharedpref" path="azure-ai-settings.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="azure-ai.db" />
        <exclude domain="database" path="azure-ai.db-wal" />
        <exclude domain="database" path="azure-ai.db-shm" />
        <exclude domain="database" path="azure-ai.db-journal" />
        <exclude domain="sharedpref" path="azure-ai-settings.xml" />
        <exclude domain="sharedpref" path="azure-ai-settings.xml.bak" />
    </device-transfer>
</data-extraction-rules>
